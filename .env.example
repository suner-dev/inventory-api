# ============================================================
# Configuration de la base de donnees
# Copier ce fichier en .env et modifier les valeurs si necessaire
# ============================================================

# URL JDBC de la base PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/inventorydb

# Utilisateur PostgreSQL
DB_USERNAME=inventory

# Mot de passe PostgreSQL
DB_PASSWORD=inventory

# Seuil de stock faible (defaut: 5)
LOW_STOCK_THRESHOLD=5

# Port de l'application (defaut: 8080)
SERVER_PORT=8080
